APP_ENV=dev
APP_NAME=apf-staffing-platform
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/apf_staffing
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Tier-0 2FA gate (PLATFORM_HANDOFF §1). Set false when the Clerk plan
# has no MFA (paid feature on production instances).
PLATFORM_MFA_ENFORCED=true
# Email (SMTP). In dev, set SMTP_HOST=mailpit to use the local mail catcher.
# In prod, point to SES SMTP endpoint and set credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=APF Platform <noreply@apf-platform.ca>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
# Public lead intake (POST /api/v1/public/leads/intake). The marketing site
# sends this value in X-Intake-Secret. Blank = the route answers 404.
LEADS_INTAKE_SECRET=

# SMS (Twilio). Leave blank to disable SMS notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Broadcasts text only when urgent or the shift starts within this many hours
# (confirmations/cancellations always text).
SMS_BROADCAST_LEAD_HOURS=24
# Web Push (PWA). Leave blank to disable — the worker UI hides the toggle.
# Generate a pair: python -m app.scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@staffig.kouamvision.com
# Background scheduler (replacement sweep + nightly reliability recompute).
# In-process daemon thread; defaults are production-ready.
SCHEDULER_ENABLED=true
REPLACEMENT_SWEEP_INTERVAL_SECONDS=300
# Warn the coordinator when a release/absence is still unfilled this many
# minutes before the shift starts (one email per request).
REPLACEMENT_ESCALATION_LEAD_MINUTES=60
RELIABILITY_RECOMPUTE_HOUR_UTC=7
# Shift times are stored as Québec wall clock; comparisons interpret them here.
SHIFT_TIMEZONE=America/Toronto
# Attendance (check-in/out, SPEC_CHECKOUT_HOURS). Geofence starts permissive:
# outside-radius stamps geo_ok=false in the audit trail but never blocks; flip
# GEOFENCE_ENFORCE once the geo_ok=false rate on real data is known.
GEOFENCE_DEFAULT_RADIUS_M=250
GEOFENCE_ENFORCE=false
CHECKIN_GRACE_MINUTES=15
MAX_SHIFT_HOURS=24
