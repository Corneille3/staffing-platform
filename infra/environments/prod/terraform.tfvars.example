aws_region              = "ca-central-1"
project_name            = "apf-staffing-platform"
environment             = "prod"
vpc_cidr                = "10.20.0.0/16"
public_subnet_cidrs     = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs    = ["10.20.11.0/24", "10.20.12.0/24"]
admin_cidr_blocks       = []
db_name                 = "apf_staffing"
db_username             = "apf_admin"
db_password             = "CHANGE_ME"
db_instance_class       = "db.t4g.micro"
backup_retention_period = 7
skip_final_snapshot     = false
deletion_protection     = true
app_instance_type       = "t3.small"
app_port                = 8000
app_image               = "<ECR_REPO_URL>:latest"
clerk_publishable_key   = "pk_live_..."
clerk_secret_key        = "sk_live_..."
clerk_issuer_url        = "https://clerk.yourdomain.com"
clerk_jwks_url          = "https://clerk.yourdomain.com/.well-known/jwks.json"
allowed_origins         = "https://staffig.yourdomain.com"

# SES outbound email
ses_domain_name          = "staffig.yourdomain.com"
ses_mail_from_address    = "noreply@staffig.yourdomain.com"

# Bootstrap admin (used by Alembic migrations to seed and promote
# the first network/platform admin)
apf_bootstrap_email      = "you@yourdomain.com"
apf_bootstrap_first_name = "Your"
apf_bootstrap_last_name  = "Name"

# SMS (Twilio). Leave blank (or omit — defaults to "") to keep SMS off.
twilio_account_sid = "AC..."
twilio_auth_token  = "CHANGE_ME"
twilio_from_number = "+15145551234"

# Public lead intake (marketing site -> API). `openssl rand -hex 32`; the same
# value goes in the marketing site's Vercel env. Omit to keep the route off.
leads_intake_secret = "CHANGE_ME"
